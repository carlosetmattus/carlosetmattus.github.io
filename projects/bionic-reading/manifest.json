{
  "manifest_version": 3,
  "name": "Bionic Reading",
  "version": "1.0.0",
  "description": "Hover over any paragraph to read it in bionic format.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
